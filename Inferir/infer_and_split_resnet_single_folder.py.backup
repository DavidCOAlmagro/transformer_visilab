                row: dict[str, Any] = {
                    "image": str(relative),
                    "item": detection,
                    "yolo_confidence_%": round(yolo_confidence * 100, 2),
                    "x1": x1, "y1": y1, "x2": x2, "y2": y2,
                    "crop_file": roi_path.name,
